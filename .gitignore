# Python bytecode
__pycache__/
*.py[cod]

# Numba on-disk JIT cache (written by @njit(cache=True))
*.nbc
*.nbi

# Experiment outputs
*.npy
*.npz
*.png
*.pdf
results/
# models/ is regenerated by scripts/train.py -- weights, the
# loss curve and the log are all run artefacts, not source
models/*
docs/gmc_paper_src.html

# gmc3d: generated cross-section libraries, ball datasets, OpenMC run folders
gmc3d/data/
gmc3d/runs/**/*.vtk
