# Python bytecode
__pycache__/
*.py[cod]

# Numba on-disk JIT cache (written by @njit(cache=True))
*.nbc
*.nbi

# Experiment outputs
*.npy
*.npz
*.png
*.pdf
results/
# models/ is regenerated by scripts/train.py -- weights, the
# loss curve and the log are all run artefacts, not source
models/*
docs/gmc_paper_src.html

# ...except a dated snapshot of one full run, committed so the numbers in
# gmc2d/SPEED.md can be checked without re-running the pipeline
!gmc2d/runs/**
